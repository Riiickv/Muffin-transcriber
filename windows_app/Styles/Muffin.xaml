<?xml version="1.0" encoding="utf-8" ?>
<!--
    The Muffin look for stock WinUI controls, so the desktop app reads as the
    same product as the phone one instead of a Windows dialog.

    This dictionary is merged AFTER XamlControlsResources on purpose: overrides
    placed in App.xaml's own ThemeDictionaries lose to the ones XamlControlsResources
    brings with it, which is what kept the buttons painting themselves with the
    user's Windows accent. MuffinTheme then recolours these brushes (and any
    same-named brush anywhere else in the tree) at startup and on every accent
    change.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF9EBB" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FF9EBB" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFF9EBB" />
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#FF9EBB" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF9EBB" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#BF000000" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#000000" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFB9CE" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFB9CE" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFB9CE" />

            <!--  mobile theme.tintFill / theme.tint: the selected-pill pair.  -->
            <SolidColorBrush x:Key="MuffinAccentTintBrush" Color="#26FF9EBB" />
            <SolidColorBrush x:Key="MuffinAccentBrush" Color="#FF9EBB" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#17FFF0F5" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#0FFFF0F5" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1FFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF9EBB" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FF9EBB" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFF9EBB" />
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#FF9EBB" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF9EBB" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#BF000000" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#000000" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#A65C77" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#A65C77" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#A65C77" />

            <SolidColorBrush x:Key="MuffinAccentTintBrush" Color="#26FF9EBB" />
            <SolidColorBrush x:Key="MuffinAccentBrush" Color="#FF9EBB" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFDFAFB" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFF8F3F5" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14000000" />
        </ResourceDictionary>

        <!--  Left empty on purpose: high contrast must keep system colours.  -->
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>

    <!--  Mobile's SPACING scale (constants/tokens.ts).  -->
    <x:Double x:Key="MuffinGapSm">8</x:Double>
    <x:Double x:Key="MuffinGapMd">12</x:Double>
    <x:Double x:Key="MuffinGapLg">16</x:Double>

    <CornerRadius x:Key="MuffinCardRadius">16</CornerRadius>
    <CornerRadius x:Key="MuffinPillRadius">999</CornerRadius>

    <!--  A group card: the equivalent of the mobile SettingsGroup container.  -->
    <Style x:Key="MuffinCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuffinCardRadius}" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style x:Key="MuffinSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="Margin" Value="4,20,0,2" />
    </Style>

    <Style x:Key="MuffinSectionFooter" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,6,4,0" />
    </Style>

    <!--
        Segmented control, copied from mobile's SegmentedControl.tsx: a track
        with a subtle surface and hairline border, and the SELECTED segment
        drawn as a 15%-accent pill with a 1px accent edge and accent-coloured
        bold text. Not a solid accent fill - that reads as a blob.
    -->
    <Style x:Key="MuffinSegmentStrip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuffinPillRadius}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--
        Each segment stretches to fill its column, so a strip of equal-width
        columns makes the mobile look: three equal thirds, the selected one a
        pill that fills its whole cell (not a floating oval). Put these in a
        Grid with even * columns.
    -->
    <Style x:Key="MuffinSegment" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MuffinPillRadius}" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="MuffinSegmentSelected"
        BasedOn="{StaticResource MuffinSegment}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource MuffinAccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuffinAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource MuffinAccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!--  Accent swatch: the circular colour buttons from mobile's SwatchRow.  -->
    <Style x:Key="MuffinSwatch" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MuffinPillRadius}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
</ResourceDictionary>
