<?xml version="1.0" encoding="utf-8" ?>
<!--
    The Muffin look for stock WinUI controls, so the desktop app reads as the
    same product as the phone one instead of a Windows dialog. Colours come from
    App.xaml's theme dictionaries; this file is shape, size and rhythm only.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Mobile's SPACING scale (constants/tokens.ts).  -->
    <x:Double x:Key="MuffinGapSm">8</x:Double>
    <x:Double x:Key="MuffinGapMd">12</x:Double>
    <x:Double x:Key="MuffinGapLg">16</x:Double>
    <x:Double x:Key="MuffinGapXl">20</x:Double>

    <!--  Mobile's RADIUS.lg for cards, RADIUS.pill for the segmented control.  -->
    <CornerRadius x:Key="MuffinCardRadius">16</CornerRadius>
    <CornerRadius x:Key="MuffinPillRadius">999</CornerRadius>

    <!--  A group card: the equivalent of the mobile SettingsGroup container.  -->
    <Style x:Key="MuffinCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuffinCardRadius}" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <!--  The little title above each group, like mobile's group headers.  -->
    <Style x:Key="MuffinSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="Margin" Value="4,20,0,2" />
    </Style>

    <!--  Footer text under a group (mobile passes `footer` to SettingsGroup).  -->
    <Style x:Key="MuffinSectionFooter" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,6,4,0" />
    </Style>

    <!--
        Segmented control, mobile's pill with the selected item filled. WinUI has
        no equivalent, so it is a pair of styles applied to buttons in a rounded
        strip: MuffinSegment for the inactive ones, MuffinSegmentSelected for the
        active one, swapped in code exactly like the mobile component does.
    -->
    <Style x:Key="MuffinSegmentStrip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MuffinPillRadius}" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="MuffinSegment" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MuffinPillRadius}" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style
        x:Key="MuffinSegmentSelected"
        BasedOn="{StaticResource MuffinSegment}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!--  Accent swatch: the circular colour buttons from mobile's SwatchRow.  -->
    <Style x:Key="MuffinSwatch" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MuffinPillRadius}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
</ResourceDictionary>
