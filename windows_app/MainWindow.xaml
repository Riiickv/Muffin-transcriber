<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MuffinTranscriber.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MuffinTranscriber"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind local:AppStrings.App_Title}"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="{x:Bind local:AppStrings.App_Title}"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <!--
                The icon goes in LeftHeader rather than IconSource, which draws
                it at a fixed 16px and cannot be told otherwise: at 16 it is a
                smudge next to 48px of title bar. 26px is as large as it goes
                without crowding the title text.

                A PNG, not the .ico. XAML's image decoder will not reliably read
                a multi-frame .ico, which is why the icon never appeared at all
                before; this is the 256px frame of that same file. The .ico
                still supplies the exe icon through ApplicationIcon.
            -->
            <TitleBar.LeftHeader>
                <Image
                    Source="ms-appx:///Assets/AppIcon.png"
                    Width="26"
                    Height="26"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center" />
            </TitleBar.LeftHeader>

            <!--
                RightHeader is the slot meant for this: it sits immediately
                left of the caption buttons and TitleBar handles click
                passthrough for it, which an overlay on the drag region would
                not get. Its own spacing is what left the gap, and guessing at
                a negative margin was wrong twice, so the code behind measures
                the real distance to the caption buttons after layout and
                closes it exactly. See NudgeSupportButton.
            -->
            <TitleBar.RightHeader>
                <Button
                    x:Name="SupportButton"
                    Click="OnSupportClick"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Width="36"
                    Height="28"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <!--
                        The app draws its own tooltips everywhere else, and that
                        framework lives in the web layer where this button
                        cannot reach it. This is the closest a XAML tooltip
                        gets: same corner radius, same hairline border, themed
                        rather than the stock pale box.
                    -->
                    <ToolTipService.ToolTip>
                        <ToolTip
                            Content="{x:Bind local:AppStrings.Settings_SupportTitle}"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            FontSize="12" />
                    </ToolTipService.ToolTip>
                    <!--
                        Ricky's logo, not a glyph: it is artwork, and it is what
                        the mobile header uses. 17x12.75 keeps its real 488x366
                        proportions; forcing it square would squash the face.

                        Pre-tinted to the danger colour, which is one value in
                        every theme, because the source PNG is a near-white
                        shape that would vanish on a light title bar.
                    -->
                    <Image Source="ms-appx:///Assets/RickLogo.png" Width="17" Height="12.75" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--
            The whole UI. It is HTML/CSS built from the mobile app's own tokens,
            fonts and icons, served from the install dir by WebView2 under a
            virtual host name: local files, no network, nothing leaves the PC.
        -->
        <controls:WebView2 x:Name="WebHost" Grid.Row="1" />

    </Grid>
</Window>
