<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MuffinTranscriber.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MuffinTranscriber"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind local:AppStrings.App_Title}"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="{x:Bind local:AppStrings.App_Title}"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <!--
                A PNG, not the .ico. XAML's image decoder will not reliably
                read a multi-frame .ico, and the icon simply never appeared.
                This is the 256px frame of that same file, extracted; the .ico
                still supplies the exe icon through ApplicationIcon.
            -->
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>

            <TitleBar.RightHeader>
                <!--
                    Mobile puts "Support me!" in Settings; on a desktop window
                    the title bar is the one piece of chrome that is always
                    there, so it lives to the left of Minimize.
                -->
                <Button
                    x:Name="SupportButton"
                    Click="OnSupportClick"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Width="36"
                    Height="28"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind local:AppStrings.Settings_SupportTitle}">
                    <!--
                        Ricky's logo, not a glyph: it is artwork, and it is what
                        the mobile header uses. 17x12.75 keeps its real 488x366
                        proportions; forcing it square would squash the face.
                        Smaller than the phone's 26px, because a title bar strip
                        is not a phone header.

                        The button is sized explicitly. Left to itself it takes
                        the default Button width, which is far wider than this
                        mark, and a centred icon in a wide button reads as a
                        mark stranded in the middle of the title bar. 36px wide
                        puts its right edge against the caption buttons with the
                        logo centred inside it.

                        The file is pre-tinted to the danger colour, which is the
                        same value in every theme, because the source PNG is a
                        near-white shape that would vanish on a light title bar.
                    -->
                    <Image Source="ms-appx:///Assets/RickLogo.png" Width="17" Height="12.75" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--
            The whole UI. It is HTML/CSS built from the mobile app's own tokens,
            fonts and icons, served from the install dir by WebView2 under a
            virtual host name: local files, no network, nothing leaves the PC.
        -->
        <controls:WebView2 x:Name="WebHost" Grid.Row="1" />

    </Grid>
</Window>
