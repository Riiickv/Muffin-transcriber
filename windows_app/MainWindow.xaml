<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MuffinTranscriber.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MuffinTranscriber"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind local:AppStrings.App_Title}"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="{x:Bind local:AppStrings.App_Title}"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The whole UI. It is HTML/CSS built from the mobile app's own tokens,
            fonts and icons, served from the install dir by WebView2 under a
            virtual host name: local files, no network, nothing leaves the PC.
        -->
        <controls:WebView2 x:Name="WebHost" Grid.Row="1" />

    </Grid>
</Window>
