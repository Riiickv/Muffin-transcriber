<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MuffinTranscriber.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MuffinTranscriber"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind local:AppStrings.App_Title}"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <!--
            No TitleBar control, and no rows. The whole window is the WebView,
            title bar included: the caption buttons, the tooltip and the title
            text were the last things Windows was drawing here. They are HTML
            now, built in shell.js, so they use the app's own tooltip, its own
            font and its own accent.

            The cost is that dragging and resizing stop being free. The page
            reports where its title strip and its buttons are, and
            SetDragRegions hands those to InputNonClientPointerSource, which is
            what tells Windows which pixels drag the window.
        -->
        <controls:WebView2 x:Name="WebHost" />
    </Grid>
</Window>
