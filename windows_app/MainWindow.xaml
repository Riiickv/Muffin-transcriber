<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MuffinTranscriber.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MuffinTranscriber"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind local:AppStrings.App_Title}"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="{x:Bind local:AppStrings.App_Title}"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <!--
                A PNG, not the .ico. XAML's image decoder will not reliably
                read a multi-frame .ico, and the icon simply never appeared.
                This is the 256px frame of that same file, extracted; the .ico
                still supplies the exe icon through ApplicationIcon.
            -->
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>

            <TitleBar.RightHeader>
                <!--
                    Mobile puts "Support me!" in Settings; on a desktop window
                    the title bar is the one piece of chrome that is always
                    there, so it lives to the left of Minimize.
                -->
                <Button
                    x:Name="SupportButton"
                    Click="OnSupportClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind local:AppStrings.Settings_SupportTitle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB51;" FontSize="14" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--
            The whole UI. It is HTML/CSS built from the mobile app's own tokens,
            fonts and icons, served from the install dir by WebView2 under a
            virtual host name: local files, no network, nothing leaves the PC.
        -->
        <controls:WebView2 x:Name="WebHost" Grid.Row="1" />

    </Grid>
</Window>
