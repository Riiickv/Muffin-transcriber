<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MuffinTranscriber.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MuffinTranscriber">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                    Muffin.xaml carries the accent and surface overrides and MUST
                    stay after XamlControlsResources: merged dictionaries are
                    searched last-first, so this is what lets our brushes win.
                -->
                <ResourceDictionary Source="ms-appx:///Styles/Muffin.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Softer geometry, closer to the mobile app's rounded cards. -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
