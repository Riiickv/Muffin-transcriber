<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MuffinTranscriber.MiniWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MuffinTranscriber"
    mc:Ignorable="d"
    Title="{x:Bind local:AppStrings.App_Title}">
    <!--
        The backdrop stays. Taking it out to paint our own flat surface left the
        window rendering as nothing at all - 400x500 of see-through, with the
        desktop showing where the UI should be - because a WinUI window with no
        backdrop composites transparent and a Background on the root grid did
        not cover it. Mica is more system-looking than the rest of the app, and
        an invisible window is worse.
    -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>


    <Grid Padding="16" RowSpacing="12" PointerPressed="Grid_PointerPressed" Background="#121212">
        <Grid.Resources>
            <!-- The web layer's colour tokens, restated for XAML. The mini window
                 is the one screen not drawn by the page, so this is the only place
                 these values have to exist twice. Keep them in step with the
                 matching custom properties at the top of web/muffin.css. -->
            <SolidColorBrush x:Key="MuffinBg" Color="#121212" />
            <SolidColorBrush x:Key="MuffinSurface" Color="#1C1C1C" />
            <SolidColorBrush x:Key="MuffinSurfaceStrong" Color="#262626" />
            <SolidColorBrush x:Key="MuffinBorder" Color="#2E2E2E" />
            <SolidColorBrush x:Key="MuffinText" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MuffinTextMuted" Color="#999999" />

            <!-- Flat, no WinUI gradient, no pointer-over lightening that the rest
                 of the app never does. Same corner as the buttons in the page. -->
            <Style x:Key="MuffinButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource MuffinSurfaceStrong}" />
                <Setter Property="Foreground" Value="{StaticResource MuffinText}" />
                <Setter Property="BorderBrush" Value="{StaticResource MuffinBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MuffinText}" />
            <Button x:Name="OpenMainButton" Click="OpenMainButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="8"
                    ToolTipService.ToolTip="{x:Bind local:AppStrings.Mini_Tooltip_OpenApp}">
                <FontIcon Glyph="&#xE8A7;" FontSize="16" Foreground="{ThemeResource MuffinAccentBrush}" />
            </Button>
        </Grid>

        <!--
            ContextFlyout and SelectionFlyout null: the built-in menu is the
            system's Cut / Copy / Select All, in the system's font, with the
            system's icons - the single most obviously not-ours thing on this
            window. The page has had its own right-click menu for weeks; this
            box was still handing out Windows'.

            The resource overrides kill the rest of the TextBox's chrome: WinUI
            thickens the bottom border to 2px in the accent colour on focus,
            which is the pink underline, and lightens the background on hover
            and focus, which nothing else in the app does.
        -->
        <TextBox x:Name="TranscriptBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="False"
                 ContextFlyout="{x:Null}" SelectionFlyout="{x:Null}"
                 Background="{StaticResource MuffinSurface}" Foreground="{StaticResource MuffinText}"
                 BorderBrush="{StaticResource MuffinBorder}" BorderThickness="1"
                 CornerRadius="12" Padding="12" FontSize="13" SelectionHighlightColor="{ThemeResource MuffinAccentBrush}">
            <TextBox.Resources>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF9EBB" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3A3A3A" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1C1C1C" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1C1C1C" />
                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF" />
            </TextBox.Resources>
        </TextBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CopyButton" Content="{x:Bind local:AppStrings.Mini_Tooltip_Copy}" Click="CopyButton_Click" IsEnabled="False"
                    Style="{StaticResource MuffinButton}" />
            <Button x:Name="FormatButton" Content="{x:Bind local:AppStrings.Mini_Tooltip_Format}" Click="FormatButton_Click" IsEnabled="False"
                    Style="{StaticResource MuffinButton}" Background="{ThemeResource MuffinAccentBrush}" Foreground="#121212" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
