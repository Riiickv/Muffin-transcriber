<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MuffinTranscriber.MiniWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MuffinTranscriber"
    mc:Ignorable="d"
    Title="{x:Bind local:AppStrings.App_Title}">

    <!--
        The whole window is the WebView, as in MainWindow. No Mica, no system
        TextBox, no system buttons: web/mini.html draws it with muffin.css, so
        it has the app's font, colours, buttons, selection, caret, tooltips and
        right-click menu because they are literally the same ones.
    -->
    <Grid x:Name="RootGrid">
        <controls:WebView2 x:Name="WebHost" />
    </Grid>
</Window>
