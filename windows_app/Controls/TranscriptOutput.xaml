<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuffinTranscriber.Controls.TranscriptOutput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MuffinTranscriber"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource MuffinCard}" Padding="20">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind local:AppStrings.Home_TranscriptTitle}" />

            <Grid Grid.Row="1">
                <Border Style="{StaticResource MuffinSegmentStrip}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TabRawButton" Content="{x:Bind local:AppStrings.Home_TabRaw}" Click="TabRawButton_Click" Style="{StaticResource MuffinSegmentSelected}" />
                        <Button x:Name="TabFormattedButton" Content="{x:Bind local:AppStrings.Home_TabFormatted}" Click="TabFormattedButton_Click" Style="{StaticResource MuffinSegment}" />
                        <Button x:Name="TabSummaryButton" Content="{x:Bind local:AppStrings.Home_TabSummary}" Click="TabSummaryButton_Click" Style="{StaticResource MuffinSegment}" />
                    </StackPanel>
                </Border>
                <Button HorizontalAlignment="Right" Click="CopyButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="{x:Bind local:AppStrings.Home_CopyButton}" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBox
                x:Name="TranscriptBox"
                Grid.Row="2"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="300"
                HorizontalAlignment="Stretch"
                PlaceholderText="{x:Bind local:AppStrings.Home_TranscriptPlaceholder}" />
        </Grid>
    </Border>
</UserControl>
