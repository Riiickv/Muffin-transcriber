<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuffinTranscriber.Controls.RecordFab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MuffinTranscriber"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Spacing="8">

        <Border
            x:Name="TimerPill"
            HorizontalAlignment="Center"
            Padding="10,3"
            Background="#B3261E"
            CornerRadius="999"
            Visibility="Collapsed">
            <TextBlock
                x:Name="TimerText"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                Text="0:00" />
        </Border>

        <Button
            x:Name="FabButton"
            Width="56"
            Height="56"
            Padding="0"
            HorizontalAlignment="Center"
            Click="FabButton_Click"
            CornerRadius="28"
            Style="{StaticResource AccentButtonStyle}">
            <FontIcon x:Name="FabIcon" FontSize="22" Glyph="&#xE720;" />
        </Button>
    </StackPanel>
</UserControl>
