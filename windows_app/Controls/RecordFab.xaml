<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuffinTranscriber.Controls.RecordFab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MuffinTranscriber"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Lives in the navigation pane, not floating over the page: as a floating
        button it sat on top of whatever was in the bottom-right corner and made
        those controls unclickable (it was covering two of the accent swatches).
        The mobile app puts the mic in the tab bar for the same reason - it
        belongs to the app chrome, not to the content.
    -->
    <StackPanel
        Margin="0,4,0,10"
        HorizontalAlignment="Center"
        Spacing="2">
        <Button
            x:Name="FabButton"
            Width="40"
            Height="40"
            Padding="0"
            HorizontalAlignment="Center"
            Click="FabButton_Click"
            CornerRadius="20"
            Style="{StaticResource AccentButtonStyle}">
            <FontIcon x:Name="FabIcon" FontSize="18" Glyph="&#xE720;" />
        </Button>

        <TextBlock
            x:Name="TimerText"
            HorizontalAlignment="Center"
            FontFamily="Consolas"
            FontSize="10"
            Foreground="#B3261E"
            Text="0:00"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
